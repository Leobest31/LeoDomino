VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public web origin for shareable Invite & Win links (no trailing slash).
# Native/Capacitor builds should set this to the production https origin.
VITE_PUBLIC_APP_URL=
# Sentry crash monitoring. The DSN is a public client key.
# Do not put SENTRY_AUTH_TOKEN in any VITE_ variable — it must never ship in the client bundle.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_BUILD_NUMBER=

# CI / production source-map upload only (Vite plugin, Node env).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
